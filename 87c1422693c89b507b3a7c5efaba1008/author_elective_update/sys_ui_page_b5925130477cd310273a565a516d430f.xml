    <script>
        var rawId = '${jvar_invoice_id}';
        var invoiceId = (rawId &amp;&amp; rawId.indexOf('jvar_invoice_id') === -1 &amp;&amp; rawId.trim() !== '') ? rawId.trim() : '';
        if (!invoiceId) {
            try {
                if (typeof GlideModal !== 'undefined' &amp;&amp; GlideModal.get()) {
                    invoiceId = GlideModal.get().getPreference('sys_id');
                } else if (window.parent &amp;&amp; window.parent.GlideModal &amp;&amp; window.parent.GlideModal.get()) {
                    invoiceId = window.parent.GlideModal.get().getPreference('sys_id');
                }
            } catch (e) {}
        }
        if (!invoiceId) {
            invoiceId = new URLSearchParams(window.location.search).get('sys_id') || new URLSearchParams(window.location.search).get('sysparm_invoice_id');
        }
        if (!invoiceId) {
            try {
                if (typeof g_form !== 'undefined' &amp;&amp; g_form.getUniqueValue()) {
                    invoiceId = g_form.getUniqueValue();
                } else if (window.parent &amp;&amp; window.parent.g_form &amp;&amp; window.parent.g_form.getUniqueValue()) {
                    invoiceId = window.parent.g_form.getUniqueValue();
                }
            } catch (e) {}
        }

        function openInFullTab() {
            if (invoiceId) {
                var topWin = window.top || window;
                topWin.open('/x_2223823_apollo_0_invoice_print.do?sys_id=' + invoiceId, '_blank');
            }
        }

        function closeReceipt() {
            try {
                if (typeof GlideModal !== 'undefined' &amp;&amp; GlideModal.get()) {
                    GlideModal.get().destroy();
                    return;
                }
                if (window.parent &amp;&amp; window.parent.GlideModal &amp;&amp; window.parent.GlideModal.get()) {
                    window.parent.GlideModal.get().destroy();
                    return;
                }
            } catch (e) {}
            window.close();
        }

        if (invoiceId) {
            var ga = new GlideAjax('x_2223823_apollo_0.ApolloPaymentUtils');
            ga.addParam('sysparm_name', 'ajaxGetInvoicePrintData');
            ga.addParam('sysparm_invoice_id', invoiceId);
            ga.getXMLAnswer(function(answer) {
                try {
                    var data = JSON.parse(answer);
                    if (!data || !data.success) {
                        return;
                    }

                    document.getElementById('hospName').innerText = data.hospital.name;
                    document.getElementById('hospAddress').innerText = data.hospital.address;
                    document.getElementById('hospPhone').innerText = 'Phone: ' + data.hospital.phone;
                    document.getElementById('hospHelpline').innerText = ']]>🚨<![CDATA[ 24x7 Emergency: ' + data.hospital.helpline;

                    document.getElementById('docTitle').innerText = data.invoice.document_title;

                    document.getElementById('patName').innerText = data.patient.name;
                    document.getElementById('patId').innerText = data.patient.id;
                    document.getElementById('patType').innerText = data.invoice.patient_type;
                    document.getElementById('patHospital').innerText = data.hospital.name;

                    document.getElementById('invNum').innerText = data.invoice.number;
                    document.getElementById('invDate').innerText = data.invoice.date;
                    document.getElementById('invMode').innerText = data.invoice.payment_mode;

                    var statusBadge = document.getElementById('invStatus');
                    var wm = document.getElementById('watermarkEl');
                    if (data.invoice.is_paid) {
                        statusBadge.innerHTML = '<span class="badge badge-paid">PAID</span>';
                        wm.className = 'watermark watermark-paid';
                        wm.innerText = 'PAID';
                    } else if (data.invoice.is_partial) {
                        statusBadge.innerHTML = '<span class="badge badge-partial">PARTIALLY PAID</span>';
                        wm.className = 'watermark watermark-partial';
                        wm.innerText = 'PARTIALLY PAID';
                    } else {
                        statusBadge.innerHTML = '<span class="badge badge-unpaid">UNPAID</span>';
                        wm.className = 'watermark watermark-unpaid';
                        wm.innerText = 'UNPAID';
                    }

                    var tb = document.getElementById('tableBody');
                    tb.innerHTML = '';
                    if (data.lines.length === 0) {
                        tb.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:15px; color:#718096;">No charge lines found for this invoice.</td></tr>';
                    } else {
                        for (var i = 0; i &lt; data.lines.length; i++) {
                            var line = data.lines[i];
                            var tr = document.createElement('tr');
                            var badgeClass = line.is_paid ? 'badge-paid' : 'badge-unpaid';
                            tr.innerHTML = 
                                '<td class="col-idx">' + line.index + '</td>' +
                                '<td><strong>' + line.description + '</strong></td>' +
                                '<td>' + line.charge_type + '</td>' +
                                '<td class="col-status"><span class="badge ' + badgeClass + '">' + line.status + '</span></td>' +
                                '<td class="col-amt">₹' + line.amount + '</td>';
                            tb.appendChild(tr);
                        }
                    }

                    var pDiv = document.getElementById('paymentsList');
                    if (data.payments.length &gt; 0) {
                        pDiv.innerHTML = '';
                        for (var p = 0; p &lt; data.payments.length; p++) {
                            var pay = data.payments[p];
                            pDiv.innerHTML += '<div class="receipt-pill"><span>Receipt #' + pay.number + '</span><span>(' + pay.mode + ')</span><strong style="color:#2e7d32;">₹' + pay.amount + '</strong><span>' + pay.status + '</span></div>';
                        }
                    }

                    document.getElementById('totAmt').innerText = '₹' + data.invoice.total_amount;
                    document.getElementById('paidAmt').innerText = '₹' + data.invoice.paid_amount;
                    document.getElementById('balAmt').innerText = '₹' + data.invoice.total_balance;

                } catch (e) {
                    console.error('Invoice render error:', e);
                }
            });
        }
    </script>
	</body>
</html>
</j:jelly>
