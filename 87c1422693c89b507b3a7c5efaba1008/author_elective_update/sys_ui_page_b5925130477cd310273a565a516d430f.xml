<body>

    <div class="no-print-bar">
        <div>
            <strong style="color:#007791;">Apollo Hospitals Invoice Preview</strong>
            <span style="font-size:12px; color:#718096; margin-left:8px;">Ready for Print / PDF Export</span>
        </div>
        <div style="display:flex; gap:8px;">
            <button class="btn btn-print" onclick="window.print();">]]>🖨<![CDATA[️ Print / Save as PDF</button>
