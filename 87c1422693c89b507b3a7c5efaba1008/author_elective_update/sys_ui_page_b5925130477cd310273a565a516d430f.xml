            &lt;button class="btn btn-close" onclick="closeReceipt();"&gt;Close&lt;/button&gt;
        &lt;/div&gt;
    &lt;/div&gt;

    &lt;div class="invoice-card" id="invoiceCard"&gt;
        &lt;div id="watermarkEl" class="watermark watermark-paid"&gt;PAID&lt;/div&gt;

        &lt;div class="invoice-header"&gt;
            &lt;div class="brand-logo-area"&gt;
                &lt;div class="logo-symbol"&gt;✚&lt;/div&gt;
                &lt;div class="brand-text"&gt;
                    &lt;h1&gt;Apollo&lt;/h1&gt;
                    &lt;p&gt;HOSPITALS&lt;/p&gt;
                &lt;/div&gt;
            &lt;/div&gt;
            &lt;div class="hospital-details"&gt;
                &lt;div class="hosp-name" id="hospName"&gt;Apollo Hospitals&lt;/div&gt;
                &lt;div id="hospAddress"&gt;Main Hospital Campus&lt;/div&gt;
                &lt;div id="hospPhone"&gt;Phone: +91-44-28290200&lt;/div&gt;
                &lt;div&gt;&lt;span class="helpline-pill" id="hospHelpline"&gt;]]&gt;🚨&lt;![CDATA[ 24x7 Emergency: 1860 500 1066&lt;/span&gt;&lt;/div&gt;
            &lt;/div&gt;
        &lt;/div&gt;

        &lt;div class="doc-title-bar"&gt;
            &lt;h2 id="docTitle"&gt;INVOICE CUM RECEIPT&lt;/h2&gt;
            &lt;div style="font-size:11.5px; color:#718096; margin-top:2px;"&gt;Official Clinical &amp;amp; Financial Statement&lt;/div&gt;
        &lt;/div&gt;

        &lt;div class="meta-container"&gt;
            &lt;div class="meta-box"&gt;
                &lt;div class="meta-box-title"&gt;Patient Details&lt;/div&gt;
                &lt;div class="meta-grid"&gt;
                    &lt;div class="meta-label"&gt;Patient Name:&lt;/div&gt;
                    &lt;div class="meta-val" id="patName"&gt;--&lt;/div&gt;
                    &lt;div class="meta-label"&gt;Patient ID:&lt;/div&gt;
                    &lt;div class="meta-val" id="patId"&gt;--&lt;/div&gt;
                    &lt;div class="meta-label"&gt;Patient Type:&lt;/div&gt;
                    &lt;div class="meta-val" id="patType"&gt;--&lt;/div&gt;
                    &lt;div class="meta-label"&gt;Hospital:&lt;/div&gt;
                    &lt;div class="meta-val" id="patHospital"&gt;--&lt;/div&gt;
                &lt;/div&gt;
            &lt;/div&gt;

            &lt;div class="meta-box"&gt;
                &lt;div class="meta-box-title"&gt;Invoice &amp;amp; Bill Details&lt;/div&gt;
                &lt;div class="meta-grid"&gt;
                    &lt;div class="meta-label"&gt;Invoice No:&lt;/div&gt;
                    &lt;div class="meta-val" id="invNum"&gt;--&lt;/div&gt;
                    &lt;div class="meta-label"&gt;Billing Date:&lt;/div&gt;
                    &lt;div class="meta-val" id="invDate"&gt;--&lt;/div&gt;
                    &lt;div class="meta-label"&gt;Bill Status:&lt;/div&gt;
                    &lt;div class="meta-val" id="invStatus"&gt;--&lt;/div&gt;
                    &lt;div class="meta-label"&gt;Payment Mode:&lt;/div&gt;
                    &lt;div class="meta-val" id="invMode"&gt;--&lt;/div&gt;
                &lt;/div&gt;
            &lt;/div&gt;
        &lt;/div&gt;

        &lt;table class="items-table"&gt;
            &lt;thead&gt;
                &lt;tr&gt;
                    &lt;th class="col-idx"&gt;#&lt;/th&gt;
                    &lt;th&gt;Particulars / Service Description&lt;/th&gt;
                    &lt;th&gt;Charge Type&lt;/th&gt;
                    &lt;th class="col-status"&gt;Status&lt;/th&gt;
                    &lt;th class="col-amt"&gt;Amount (₹)&lt;/th&gt;
                &lt;/tr&gt;
            &lt;/thead&gt;
            &lt;tbody id="tableBody"&gt;
                &lt;tr&gt;&lt;td colspan="5" style="text-align:center; padding:15px;"&gt;Loading invoice line items...&lt;/td&gt;&lt;/tr&gt;
            &lt;/tbody&gt;
        &lt;/table&gt;

        &lt;div class="summary-container"&gt;
            &lt;div class="payment-history-box"&gt;
                &lt;div class="payment-history-title"&gt;Associated Payment Receipts&lt;/div&gt;
                &lt;div id="paymentsList"&gt;&lt;span style="color:#a0aec0;"&gt;No payments recorded yet.&lt;/span&gt;&lt;/div&gt;
                &lt;div style="margin-top:8px; font-size:10.5px; color:#718096;"&gt;
                    * All transactions verified against Apollo Hospitals Billing Ledger.
                &lt;/div&gt;
            &lt;/div&gt;

            &lt;table class="totals-table"&gt;
                &lt;tr&gt;
                    &lt;td style="color:#718096; font-weight:600;"&gt;Total Bill Amount:&lt;/td&gt;
                    &lt;td style="text-align:right; font-weight:700;" id="totAmt"&gt;₹0.00&lt;/td&gt;
                &lt;/tr&gt;
                &lt;tr&gt;
                    &lt;td style="color:#2e7d32; font-weight:600;"&gt;Amount Paid / Collected:&lt;/td&gt;
                    &lt;td style="text-align:right; font-weight:700; color:#2e7d32;" id="paidAmt"&gt;₹0.00&lt;/td&gt;
                &lt;/tr&gt;
                &lt;tr class="total-due"&gt;
                    &lt;td&gt;Balance Due:&lt;/td&gt;
                    &lt;td style="text-align:right;" id="balAmt"&gt;₹0.00&lt;/td&gt;
                &lt;/tr&gt;
            &lt;/table&gt;
