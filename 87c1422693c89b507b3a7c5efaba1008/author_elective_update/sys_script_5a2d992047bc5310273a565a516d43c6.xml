        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    var count = parseInt(current.getValue('conflict_count') || '0', 10);
    var resolved = (current.getValue('conflicts_resolved') == '1' || current.getValue('conflicts_resolved') === true);

    // If change request is flagged with unresolved conflicts, block immediately
    if (!resolved || count > 0) {
        var msg = '<b>Cannot move Change Request to Scheduled:</b><br/>' +
            'There are <b>' + count + '</b> unresolved booking conflict(s) on equipment ' +
            current.cmdb_ci.getDisplayValue() + ' during this maintenance window.<br/>' +
            'Please use the <b>Resolve Conflicts</b> button to resolve all affected bookings before confirming the schedule.';
        gs.addErrorMessage(msg);
        current.setAbortAction(true);
    }
})(current, previous);]]></script>
