        <condition/>
        <description>End Date can not be earlier than Start Date   if it is show error message and does not allow to submitt fom.</description>
        <field/>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>End Date can't be earlier than Start Dat</name>
        <order/>
        <script><![CDATA[function onSubmit() {
    var startDate = g_form.getValue('start_date');
    var endDate = g_form.getValue('end_date');

    // both fields are not empty
    if (startDate && endDate) {
        // if End date is earlier than STart Date
        if (startDate > endDate) {
			g_form.setValue('end_date','');
            g_form.addErrorMessage('End Date can not be earlier than Start Date.');
            return false; // it stops form to be submitted .
        }
    }
}]]></script>
