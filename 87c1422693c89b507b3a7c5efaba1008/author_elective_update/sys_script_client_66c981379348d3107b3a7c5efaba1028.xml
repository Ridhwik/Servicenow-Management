        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }
   var admit = new Date(g_form.getValue('admission_date'));
   var discharge = new Date(newValue);

   if(admit > discharge) {
	g_form.setValue('discharge_date', '');
	g_form.showErrorBox('discharge_date', 'Discharge Date cannot be earlier than the Admit date');
   }

