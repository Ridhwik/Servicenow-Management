        <script><![CDATA[// --- Client-Side Section ---
function confirmAndResolveConflicts() {
    var gm = new GlideModal('glide_confirm_standard', false, 400);
    gm.setTitle('Confirm Conflict Resolution');
    gm.setPreference('title', 'Are you sure you want to mark all conflicts as resolved?');
    gm.setPreference('onPromptComplete', function() {
        gsftSubmit(null, g_form.getFormElement(), 'resolve_equipment_conflicts');
    });
    gm.render();
}

// --- Server-Side Section ---
if (typeof window == 'undefined') {
    runResolveConflictsServer();
}

function runResolveConflictsServer() {
    var service = new x_2223823_apollo_0.ConflictService();
    var count = service.resolveConflictsForChange(current);

    if (count > 0) {
        gs.addInfoMessage("Successfully resolved " + count + " conflict(s). Conflicting lab test results moved to 'Needs Rescheduling' and reschedule offers generated. You can now schedule this Change.");
    } else {
        gs.addInfoMessage("No active conflicts found to resolve.");
    }
    action.setRedirectURL(current);
}]]></script>
