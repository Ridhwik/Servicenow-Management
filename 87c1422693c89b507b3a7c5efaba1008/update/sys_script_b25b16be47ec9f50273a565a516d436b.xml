        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    // Verify both Department and Hospital are present
    if (!current.department.nil() && !current.hospital.nil()) {
        
        // Dot-walk to fetch the hospital associated with the department
        var deptHospital = current.department.hospital.toString();
        var staffHospital = current.getValue('hospital');

        // Check if the department's hospital matches the staff's hospital
        if (deptHospital && staffHospital && deptHospital !== staffHospital) {
            gs.addErrorMessage('The selected Department does not belong to the selected Hospital.');
            current.setAbortAction(true);
        }
    }

})(current, previous);]]></script>
