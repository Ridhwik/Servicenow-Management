        <script><![CDATA[/**
 * UI Action: Create Payment (Whole Invoice)
 * Table: x_2223823_apollo_0_invoice
 * Action Name: apollo_invoice_create_payment
 * Form Button: true
 * Show Insert: false
 * Show Update: true
 * Condition: current.total_balance > 0 && current.status != 'paid' && current.status != 'cancelled'
 */

(function executeAction(current) {

    var utils = new x_2223823_apollo_0.ApolloPaymentUtils();
    var result = utils.createPaymentForInvoice(current.getUniqueValue());

    if (result.success) {
        gs.addInfoMessage(result.message);
        // Redirect directly to the newly created Payment record for verification / receipt print
        action.setRedirectURL('x_2223823_apollo_0_payment.do?sys_id=' + result.payment_id);
    } else {
        gs.addErrorMessage(result.message);
        action.setRedirectURL(current);
    }

})(current);
]]></script>
