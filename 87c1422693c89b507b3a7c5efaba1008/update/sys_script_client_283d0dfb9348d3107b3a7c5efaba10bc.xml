        <name>Est.Discharge Date validation with admit</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }
   var admit = new Date(g_form.getValue('admission_date'));
   var Estdischarge = new Date(newValue);

   if(admit > Estdischarge) {
	g_form.setValue('expected_discharge_date', '');
	g_form.showErrorBox('expected_discharge_date', 'Expected Discharge Date cannot be earlier than the Admit date');
   }

