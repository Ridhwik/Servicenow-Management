        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    if (!current.status.changes() || current.getDisplayValue('status') != 'Discharged') { return; }

    var settled = false;
    var inv = new GlideRecord('x_2223823_apollo_0_invoice');
    inv.addQuery('admission', current.getUniqueValue());
    inv.addQuery('is_final', true);
    inv.query();
    while (inv.next()) {
        if (inv.getDisplayValue('status') == 'Paid') { settled = true; break; }
    }

    if (!settled) {
        gs.addErrorMessage('The final invoice must be paid before discharge.');
        current.setAbortAction(true);
    }
})(current, previous);]]></script>
