        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    if (!current.room.nil() && !current.hospital.nil()) {
        
        // Dot-walk to fetch the hospital associated with the selected room
        var roomHospital = current.room.hospital.toString();
        var bedHospital = current.getValue('hospital');

        // Check if room's hospital matches bed's hospital
        if (roomHospital && bedHospital && roomHospital !== bedHospital) {
            gs.addErrorMessage('Validation Failed: The selected Room does not belong to the selected Hospital.');
            current.setAbortAction(true);
        }
    }

})(current, previous);]]></script>
