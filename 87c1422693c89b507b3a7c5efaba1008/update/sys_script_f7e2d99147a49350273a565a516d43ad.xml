        <script><![CDATA[(function executeRule(current, previous) {

    // Check whether invoice already exists
    var invoice = new GlideRecord('x_2223823_apollo_0_invoice');

    // Create new invoice
    invoice.initialize();

    invoice.setValue('admission', current.getUniqueValue());
    invoice.setValue('patient', current.getValue('patient'));
    invoice.setValue('hospital', current.getValue('hospital'));

    invoice.setValue('total_amount', 0);
    invoice.setValue('paid_amount', 0);
    invoice.setValue('balance_amount', 0);
    invoice.setValue('final_invoice', false);
    invoice.setValue('status', 'draft');
	invoice.setValue('patient_type', 'inpatient');


    var invoiceId = invoice.insert();

    if (invoiceId) {
        current.setValue('final_invoice', invoiceId);
    }

})(current, previous);]]></script>
