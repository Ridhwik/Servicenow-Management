        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    var slotStart = new GlideDateTime(current.start_time);
    var now = new GlideDateTime();

    // Check 1: Cannot book in the past
    if (slotStart.getNumericValue() < now.getNumericValue()) {
        current.setAbortAction(true);
        gs.addErrorMessage('Appointment slot cannot be in the past.');
        return;
    }

    // Check 2: Max 7 days advance booking window
    var maxWindow = new GlideDateTime();
    maxWindow.addDaysLocalTime(7);

    if (slotStart.after(maxWindow)) {
        current.setAbortAction(true);
        gs.addErrorMessage('Video appointments can only be booked up to 7 days in advance.');
    }

})(current, previous);]]></script>
