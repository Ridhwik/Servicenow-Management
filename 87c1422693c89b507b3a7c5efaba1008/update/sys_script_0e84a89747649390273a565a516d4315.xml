        <script><![CDATA[(function executeRule(current, previous) {

    if (!current.status.changes()) {
        return;
    }

    var machine = new LabResultStateMachine();

    var targetStatus = current.getDisplayValue('status');

    // Restore the old status before calling transition().
    var oldStatus = previous.getValue('status');

    current.setValue('status', oldStatus);

    var response = machine.transition(current, targetStatus);

    if (!response || !response.ok) {

        gs.addErrorMessage(
            response && response.message
                ? response.message
                : 'FL-04: Invalid status transition.'
        );

        current.setAbortAction(true);
        return;
    }

    // transition() must set the target status after validation.
    // Do not call current.update() here.

})(current, previous);]]></script>
