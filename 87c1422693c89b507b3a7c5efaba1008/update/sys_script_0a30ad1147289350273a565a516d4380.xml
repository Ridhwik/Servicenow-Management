        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    var regNo = ('' + (current.registration_no || current.registration_number)).trim();
    if (!regNo) return;

    var gr = new GlideRecord('x_2223823_apollo_0_doctor');
    var qc = gr.addQuery('registration_no', regNo);
    qc.addOrCondition('registration_number', regNo);
    gr.addQuery('sys_id', '!=', current.sys_id);
    gr.setLimit(1);
    gr.query();

    if (gr.next()) {
        current.setAbortAction(true);
        gs.addErrorMessage('A doctor with Medical Council registration number "' + regNo + '" already exists (' + (gr.number || gr.user.getDisplayValue() || gr.sys_id) + ').');
    }

})(current, previous);]]></script>
